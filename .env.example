# Smart Campus Resource Optimizer - Environment Configuration

# URL to the Python Algorithm Engine microservice (FastAPI / Uvicorn)
ALGORITHM_ENGINE_URL=http://127.0.0.1:8000

# SQLite Database path for audit trail (preserved from python engine)
AUDIT_LOG_DB_PATH=./audit_log.db

# Optional internal secret key for server-to-server authorization
ENGINE_API_SECRET=your_secret_key_here
