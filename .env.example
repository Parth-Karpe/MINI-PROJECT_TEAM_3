# Smart Campus Resource Optimizer - Environment Configuration
# Copy to .env.local and adjust. Server-side only -- never expose to the client.

# URL to the Python Algorithm Engine microservice (FastAPI / Uvicorn)
ALGORITHM_ENGINE_URL=http://127.0.0.1:8000

# SQLite Database path for audit trail (preserved from python engine)
AUDIT_LOG_DB_PATH=./audit_log.db

# Optional internal secret key for server-to-server authorization
ENGINE_API_SECRET=your_secret_key_here

# Browser URL for the dashboard redirect from the Python service (set in its environment)
SMART_CAMPUS_WEB_URL=http://localhost:3000

# Port the Next.js production server listens on (dev uses 3000 by default)
PORT=3000

# Hosted FastAPI only. Keep this connection string outside source control.
# CAMPUS_DATABASE_URL=postgresql://.../?sslmode=require
# Same server-only gateway secret on Next.js and FastAPI.
# CAMPUS_GATEWAY_SECRET=
# Hosted Next.js only. Server-only JSON containing a signing secret and salted account hashes.
# CAMPUS_AUTH_CONFIG_JSON=
